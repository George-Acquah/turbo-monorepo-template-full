{
  "name": "@workspace/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.2",
    "@workspace/audit": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/cache": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/constants": "workspace:*",
    "@workspace/context": "workspace:*",
    "@workspace/auth-core": "workspace:*",
    "@workspace/decorators": "workspace:*",
    "@workspace/encryption": "workspace:*",
    "@workspace/events": "workspace:*",
    "@workspace/files": "workspace:*",
    "@workspace/filters": "workspace:*",
    "@workspace/guards": "workspace:*",
    "@workspace/identity": "workspace:*",
    "@workspace/interceptor": "workspace:*",
    "@workspace/mongo": "workspace:*",
    "@workspace/notifications": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/outbox-persistence": "workspace:*",
    "@workspace/permissions": "workspace:*",
    "@workspace/ports": "workspace:*",
    "@workspace/prisma": "workspace:*",
    "@workspace/profiles": "workspace:*",
    "@workspace/queue": "workspace:*",
    "@workspace/rate-limit": "workspace:*",
    "@workspace/realtime": "workspace:*",
    "@workspace/redis": "workspace:*",
    "@workspace/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@workspace/eslint": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.1",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.20.3",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
