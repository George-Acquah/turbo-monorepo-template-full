# =========================
# API
# =========================
# Bare origin of apps/api — no path suffix. The typed client
# (@workspace/client-api, via packages/client/api) and the generated OpenAPI
# paths already carry the full /api/v1/... prefix, so this must NOT include
# /api or /api/v1 itself. Read on both the server (server.env.ts) and the
# client (env.ts) — must be NEXT_PUBLIC_ to reach the browser bundle.
#
# Dev:  http://localhost:3000   (apps/api's local PORT, see apps/api/.env.example)
# Prod: https://api.example.com — confirm the real subdomain before deploying.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Shared secret sent as the X-Origin-Auth header on server-side calls to
# apps/api (shared/api/server.ts — RSC reads, server actions, token refresh)
# — must exactly match apps/api's ORIGIN_AUTH_SECRET (see
# apps/api/.env.example). Deliberately NOT prefixed NEXT_PUBLIC_: the browser
# client (shared/api/client.ts) must never see this value, or it would ship
# into the JS bundle and stop being a secret. Leave unset locally if apps/api
# is running with NODE_ENV=development, which bypasses the check.
ORIGIN_AUTH_SECRET=

# Registrable-domain scope for the auth cookies (app_access_token,
# app_refresh_token — see shared/lib/cookies.ts) so they're also sent on
# browser requests to api.example.com, not just this app's own origin.
# Leave UNSET for local dev AND for Vercel Preview/Development environments —
# only set to `.example.com` in the real Vercel Production environment.
# Setting this on a *.vercel.app preview deployment makes the browser reject
# the cookie outright (its Domain attribute won't match the response's host).
COOKIE_DOMAIN=

# =========================
# CLOUDFLARE TURNSTILE (bot protection on login/register)
# =========================
# Public site key — safe in the browser bundle. Verification itself happens
# server-side in apps/api's modules/auth (TURNSTILE_SECRET_KEY, see
# apps/api/.env.example) — this app never verifies the token itself.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =========================
# NOTES
# =========================
# NODE_ENV is set automatically by Next.js (dev/build/start) — do not set it
# here.
