{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.Workers"
  },
  "deploy": {
    "startCommand": "pnpm --filter=@workspace/worker run start:prod",
    "preDeployCommand": ["pnpm --filter=@workspace/prisma run migrate:deploy"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
