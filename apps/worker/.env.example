# =========================
# APP
# =========================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DEBUG_METRICS=false
JSON_BODY_LIMIT=1mb
CONTEXT_EXPOSE_RAW_REQUEST=false
CONTEXT_ALLOW_LEGACY_TENANT_HEADER=false

# =========================
# SHARED INFRASTRUCTURE
# =========================
# Shared: canonical transactional store for api + workers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_dev_pg
# Max Postgres connections held by this process. Must be set here — a
# `?connection_limit=` on DATABASE_URL is ignored by the @prisma/adapter-pg
# driver adapter. Every replica opens its own pool, so keep
# (api pool x api replicas) + (worker pool x worker replicas) under the
# database's connection cap.
DATABASE_POOL_MAX=10

# Shared: Mongo document store for Mongo-owned concerns and projections
# such as notifications/search when those modules are enabled.
MONGODB_URI=mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=workspace_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Shared: object storage provider for api + workers.
STORAGE_PROVIDER=local
STORAGE_DEFAULT_BUCKET=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage
STORAGE_LOCAL_ROOT=../.data/storage

# Shared: S3-compatible provider vars.
# Required for non-local providers. `STORAGE_S3_ENDPOINT` is optional for AWS S3,
# but required for R2/Supabase-style compatible endpoints.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Private bucket (signed URLs only) — lesson/replay video, resources, receipts.
# e.g. workspace-private-staging / workspace-private-production. See
# docs/infrastructure/decisions/adr-0007-cloudflare-r2-storage.md.
STORAGE_S3_BUCKET=
# Public bucket (custom-domain read access) — avatars, logos, thumbnails only.
# e.g. workspace-public-staging / workspace-public-production. Leave unset to
# keep every upload private (old single-bucket behaviour).
STORAGE_S3_PUBLIC_BUCKET=
STORAGE_S3_FORCE_PATH_STYLE=false

# =========================
# REDIS (shared infra)
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379
REDIS_CONNECTION_TIMEOUT=5000
REDIS_TLS=false

# =========================
# API ONLY: JWT
# =========================
JWT_ACCESS_TOKEN_SECRET=super-secret-access-key
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=super-secret-refresh-key
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_REFRESH_ROTATION=true
# MFA-specific token secret (separate from access/refresh — keeps MFA challenge
# tokens invalidatable independently) and the secret used to hash stored
# opaque tokens (refresh/reset/verification) before persisting them.
JWT_MFA_TOKEN_SECRET=super-secret-mfa-key
TOKEN_HASH_SECRET=super-secret-token-hash-key
JWT_ISSUER=workspace
JWT_AUDIENCE=workspace

# =========================
# API ONLY: CORS / origin security
# =========================
# Comma-separated list of allowed browser origins. Empty = open (local dev
# only) — required (non-empty) once NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# X-Origin-Auth only needs to be here for completeness/preflight — the header
# itself is only ever sent server-to-server (see ORIGIN_AUTH_SECRET below),
# never by a browser, so it never actually goes through a CORS preflight.
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Origin-Auth
# Shared secret checked by OriginAuthMiddleware for non-browser callers
# (server-to-server: apps/landing's server-only fetch, apps/members and
# apps/backoffice's RSC/server-action clients, apps/worker). Never send this
# from a browser-side client — it would ship the secret into the JS bundle.
# Bypassed automatically when NODE_ENV=development.
ORIGIN_AUTH_SECRET=super-secret-origin-auth-key

# =========================
# API ONLY: OAuth (dummy)
# =========================
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_SCOPES=openid,email,profile

GITHUB_CLIENT_ID=dummy-github-client-id
GITHUB_CLIENT_SECRET=dummy-github-client-secret
GITHUB_SCOPES=user:email

# =========================
# Shared observability
# =========================
ENABLE_LOKI=false

GRAFANA_ENV=local
GRAFANA_INSTANCE=local
GRAFANA_APP_NAME=workspace-worker
GRAFANA_APP_VERSION=0.0.1

GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_PASSWORD=

GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_PASSWORD=

GRAFANA_METRICS_USER=
GRAFANA_METRICS_PASSWORD=

LOCAL_LOKI_HOST=http://localhost:3100

# =========================
# BRANDING / FRONTEND
# =========================
# API_URL: public-facing base URL of this API server.
API_URL=http://localhost:3000
# LANDING_URL  = apps/landing, the public marketing site  (dev :3002)
# PORTAL_URL   = apps/members, the authenticated member app / "dashboard" (dev :3003)
# Email templates link members to PORTAL_URL (dashboard, billing, learn,
# settings) and to LANDING_URL for public pages (programmes, events).
# Payment-provider callback/return URLs fall back to LANDING_URL then PORTAL_URL.
LANDING_URL=http://localhost:3002
PORTAL_URL=http://localhost:3003
LANDING_NAME=workspace
SUPPORT_EMAIL=support@example.com

# =========================
# EMAIL — category-based multi-provider routing
# (see docs/infrastructure/decisions/adr-0009-email-providers.md)
# =========================
# EMAIL_ROUTING_MODE=single (default) always uses EMAIL_PROVIDER for every email.
# EMAIL_ROUTING_MODE=category routes per-message using the EMAIL_*_PROVIDER
# overrides below, falling back to EMAIL_PROVIDER for any category left unset.
EMAIL_ROUTING_MODE=single

# Recommended production values when EMAIL_ROUTING_MODE=category:
#   EMAIL_SECURITY_PROVIDER=resend
#   EMAIL_PAYMENTS_PROVIDER=mailtrap
#   EMAIL_EVENTS_PROVIDER=resend
#   EMAIL_MARKETING_PROVIDER=mailgun
EMAIL_SECURITY_PROVIDER=
EMAIL_PAYMENTS_PROVIDER=
EMAIL_EVENTS_PROVIDER=
EMAIL_MARKETING_PROVIDER=

# --- Resend credentials & sender domain override ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=

# --- Mailgun credentials & sender domain override ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAILGUN_FROM_ADDRESS=
MAILGUN_FROM_NAME=

# --- Mailtrap Sending API credentials & sender domain override ---
# This is Mailtrap's transactional Sending API token, distinct from the
# Testing/sandbox product's SMTP credentials referenced below under
# EMAIL_PROVIDER=smtp. Generate it in the Mailtrap dashboard after verifying a
# sending domain.
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_ADDRESS=
MAILTRAP_FROM_NAME=

# --- SMTP / EMAIL_PROVIDER (single-mode default, and the non-production
# fallback for any category left unset in category mode). Point at
# Mailtrap's Email Testing sandbox in staging so non-prod never emails
# real recipients. ---
EMAIL_PROVIDER=smtp
# For local development with MailHog (recommended):
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# For staging with Mailtrap's Email Testing sandbox:
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your-mailtrap-inbox-user
# EMAIL_PASSWORD=your-mailtrap-inbox-password
# For production with Gmail SMTP (free, no custom domain needed):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-16-char-app-password
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

EMAIL_FROM_NAME=workspace
EMAIL_FROM_ADDRESS=noreply@example.com
# When set, ALL outgoing emails are redirected here instead of the real
# recipient (dev/test only).
EMAIL_OVERRIDE_TO=
# Verify the SMTP transporter can connect before sending. Defaults to true
# in production, false otherwise — set explicitly to override.
VERIFY_EMAIL_TRANSPORTER=false

# =========================
# WHATSAPP
# =========================
# Provider: twilio | meta
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v21.0

# =========================
# SMS
# =========================
# Reuses the Twilio account above (TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN) —
# only the "from" number differs from WhatsApp.
TWILIO_SMS_FROM=

# =========================
# PUSH (Firebase Cloud Messaging)
# =========================
# Standard Firebase service-account triple. FCM_PRIVATE_KEY may use escaped
# \n sequences (a real .env value can't hold literal newlines).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# =========================
# PAYMENT PROVIDERS
# =========================
# Default provider: hubtel | paystack | flutterwave
PAYMENT_PROVIDER=hubtel
# Refund request window in days from Payment.capturedAt — override with
# refund:approve permission after this. Confirmed final (2026-08-13) — matches
# apps/landing's /refund-policy page and the corrected terms/page.tsx figure.
REFUND_WINDOW_DAYS=14
# Subscription renewal grace/pre-renewal-notice windows in days. Placeholders
# pending business sign-off.
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_PRE_RENEWAL_NOTICE_DAYS=3
# Hubtel
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_POS_SALES_ID=
HUBTEL_WEBHOOK_URL=
HUBTEL_CALLBACK_URL=
HUBTEL_RETURN_URL=
HUBTEL_CANCEL_URL=
HUBTEL_REFUND_CALLBACK_URL=
# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_RETURN_URL=
PAYSTACK_CANCEL_URL=
# Flutterwave (FLW_SECRET_KEY and FLUTTERWAVE_SECRET_KEY are interchangeable aliases)
FLW_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CALLBACK_URL=
FLUTTERWAVE_RETURN_URL=
FLUTTERWAVE_CANCEL_URL=

# =========================
# ENCRYPTION
# =========================
# AES-256-GCM key for payload-at-rest encryption (webhook raw payloads,
# payment attempt request/response logs), consumed by @workspace/encryption.
# Must match apps/api's value — same secret, both processes decrypt what the
# other encrypted. 32 random bytes, hex-encoded (64 hex chars), e.g.
# `openssl rand -hex 32`.
ENCRYPTION_KEY=
