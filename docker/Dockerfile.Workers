# syntax=docker/dockerfile:1
# ------------------------------------------------------
# 1. Base Image
# ------------------------------------------------------
FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate
WORKDIR /repo

# ------------------------------------------------------
# 2. Prune
# ------------------------------------------------------
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo prune @workspace/worker --docker --out-dir=out

# ------------------------------------------------------
# 3. Installer
# ------------------------------------------------------
FROM base AS installer
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
# See Dockerfile.API's matching comment: turbo prune's out/json/ doesn't
# carry root dotfiles, so .npmrc must be copied in explicitly.
COPY .npmrc ./.npmrc

# Cache mount for pnpm's content-addressable store — see Dockerfile.API's
# matching comment and .npmrc's header for why this was added.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --no-frozen-lockfile

COPY --from=pruner /repo/out/full/ .
COPY --from=pruner /repo/turbo.json ./turbo.json

ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"

RUN pnpm --filter=@workspace/prisma run prisma:generate
RUN pnpm run build --filter=@workspace/worker

# ------------------------------------------------------
# 4. Production Runner
# ------------------------------------------------------
FROM node:22-slim AS runner

ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/app/.corepack"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/* && \
    addgroup --system app && adduser --system --ingroup app app

WORKDIR /app

RUN mkdir -p /app /app/.corepack /pnpm && chown -R app:app /app /pnpm

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY --from=installer --chown=app:app /repo ./

USER app

ENV NODE_ENV=production

# See Dockerfile.API's matching comment: `pnpm run start:prod` is just
# `node dist/main` (apps/worker/package.json) wrapped in a pnpm invocation that
# re-verifies the whole lockfile against the registry on every container start —
# invoke the compiled entrypoint directly instead.
CMD ["node", "apps/worker/dist/main.js"]
