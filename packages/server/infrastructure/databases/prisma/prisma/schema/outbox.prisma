// =============================================================================
// workspace_outbox — Reliable messaging infrastructure
//
// Transactional outbox, dead-letter queue, saga state, and idempotency keys.
// Infrastructure-owned; no business meaning beyond reliable delivery. Field
// shapes mirror ports/src/database/schema/events/types.ts and the status enums
// in @workspace/constants (OutboxEventStatus, DLQEventStatus, SagaStatus,
// IdempotencyStatus). Single-tenant: no organizationId.
//
// (This is the infra content formerly in events.prisma; the events.prisma file
// now owns the LiveEvent domain.)
// =============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// OutboxEvent — transactional outbox. Written in the same tx as the aggregate
// change, then drained onto BullMQ by the outbox relay (see @workspace/events).
// ─────────────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id String @id // obe_*

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventType     String @map("event_type")
  eventVersion  Int    @default(1) @map("event_version")

  payload       Json    @db.JsonB
  metadata      Json?   @db.JsonB
  correlationId String? @map("correlation_id")
  partitionKey  String? @map("partition_key") // ordering / partitioning

  /// @check(status IN ('PENDING','PROCESSING','PROCESSED','FAILED','DEAD_LETTERED'))
  status String @default("PENDING")

  attempts      Int       @default(0)
  maxAttempts   Int       @default(5) @map("max_attempts")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  nextRetryAt   DateTime? @map("next_retry_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRetryAt, createdAt]) // drain query
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
  @@schema("workspace_outbox")
}

// NOTE: this table also carries a PARTIAL index that cannot be declared above
// — Prisma's schema DSL has no syntax for an index predicate. It is created by
// migration 20260804161500_outbox_drain_partial_index:
//
//   outbox_events_dispatchable_created_at_idx
//     ON (created_at) WHERE status IN ('PENDING','FAILED','PROCESSING')
//
// It is what keeps the drain's index proportional to the backlog rather than
// to total history. Because Prisma cannot see it, `prisma migrate dev` will
// report it as drift and offer to DROP it — do not accept that. Same caveat
// applies to the CHECK constraints generated by scripts/build-check-constraints.mjs.

// ─────────────────────────────────────────────────────────────────────────────
// DeadLetterEvent — events that exhausted retries. status = DLQEventStatus.
// ─────────────────────────────────────────────────────────────────────────────
model DeadLetterEvent {
  id String @id // dlq_*

  source          String // queue name or topic
  originalEventId String? @map("original_event_id")
  eventType       String  @map("event_type")
  payload         Json    @db.JsonB

  errorMessage String  @map("error_message")
  errorStack   String? @map("error_stack")
  attempts     Int     @default(1)

  /// @check(status IN ('UNRESOLVED','RETRYING','RESOLVED','IGNORED'))
  status     String    @default("UNRESOLVED")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([eventType])
  @@map("dead_letter_events")
  @@schema("workspace_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// SagaState — long-running orchestration state. status = SagaStatus.
// ─────────────────────────────────────────────────────────────────────────────
model SagaState {
  id            String @id // sag_*
  sagaType      String @map("saga_type")
  correlationId String @map("correlation_id")
  currentStep   String @map("current_step")

  /// @check(status IN ('STARTED','IN_PROGRESS','COMPLETED','COMPENSATING','COMPENSATED','FAILED'))
  status String @default("STARTED")

  data           Json     @db.JsonB
  completedSteps String[] @default([]) @map("completed_steps")
  failedStep     String?  @map("failed_step")
  lastError      String?  @map("last_error")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  timeoutAt   DateTime? @map("timeout_at") @db.Timestamptz(6)
  attempts    Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sagaType, correlationId])
  @@index([status, timeoutAt]) // cleanup service query
  @@map("saga_states")
  @@schema("workspace_outbox")
  @@index([correlationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// IdempotencyKey — dedup for http/event/job scopes. status = IdempotencyStatus.
// ─────────────────────────────────────────────────────────────────────────────
model IdempotencyKey {
  id    String @id // idk_*
  key   String
  scope String // 'http' | 'event' | 'job'

  /// @check(status IN ('IN_PROGRESS','COMPLETED','FAILED'))
  status String @default("IN_PROGRESS")

  requestHash     String?   @map("request_hash")
  responsePayload Json?     @map("response_payload") @db.JsonB
  statusCode      Int?      @map("status_code")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("workspace_outbox")
}
