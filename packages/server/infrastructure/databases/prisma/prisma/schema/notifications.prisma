// =============================================================================
// workspace_notifications — Notification CONFIG (Postgres side)
//
// This schema holds notification CONFIGURATION only: templates, per-user
// preferences, channel provider config, compliance overrides, and push-device
// registrations. It is low-volume, relational, and tied to consent/compliance.
//
// The high-volume, document-shaped RECORDS live in MongoDB (see the mongo
// package): notification instances, per-channel delivery logs, and the in-app
// feed. This is the config-vs-records split (reshaped from the legacy
// communications.prisma; single-tenant — organizationId columns removed).
//
// Field shapes align with the "Prisma Communications schema types" section of
// ports/src/database/schema/notifications/notification.types.ts.
// =============================================================================

model NotificationTemplate {
  id String @id // ntt_*

  key         String // e.g. 'enrolment.activated'
  name        String
  description String?

  /// @check(channel IN ('EMAIL','SMS','PUSH','IN_APP','WHATSAPP'))
  channel String

  subject   String?
  body      String
  variables Json?   @db.JsonB

  version         Int     @default(1)
  isActive        Boolean @default(true) @map("is_active")
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([key, channel, version])
  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
  @@schema("workspace_notifications")
}

model NotificationPreference {
  id     String @id // npr_*
  userId String @map("user_id")

  /// @check(channel IN ('EMAIL','SMS','PUSH','IN_APP','WHATSAPP'))
  channel  String
  category String

  enabled           Boolean @default(true)
  quietHoursEnabled Boolean @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String? @map("quiet_hours_start")
  quietHoursEnd     String? @map("quiet_hours_end")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, channel, category])
  @@map("notification_preferences")
  @@schema("workspace_notifications")
}

// Forced-delivery override for compliance-critical categories (e.g. security,
// legal) that bypass user preference/opt-out. Applied by the dispatch pipeline.
model CommunicationPreferenceOverride {
  id       String @id // cpo_*
  category String

  /// @check(reason IN ('COMPLIANCE','FINANCIAL','LEGAL','SECURITY','SYSTEM'))
  reason String

  forceDelivery   Boolean   @default(true) @map("force_delivery")
  createdByUserId String?   @map("created_by_user_id")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([category])
  @@map("communication_preference_overrides")
  @@schema("workspace_notifications")
}

model NotificationChannelConfig {
  id String @id // ntc_*

  /// @check(channel IN ('EMAIL','SMS','PUSH','WHATSAPP'))
  channel  String
  provider String

  isDefault            Boolean @default(false) @map("is_default")
  isActive             Boolean @default(true) @map("is_active")
  credentialsEncrypted String  @map("credentials_encrypted")
  settings             Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([channel, provider])
  @@map("notification_channel_configs")
  @@schema("workspace_notifications")
}

// Push-device registry (dormant in v1 — push processors not registered yet).
model PushDevice {
  id     String @id // pdv_*
  userId String @map("user_id")

  /// @check(platform IN ('IOS','ANDROID','WEB'))
  platform String

  deviceToken String    @map("device_token")
  deviceId    String?   @map("device_id")
  appVersion  String?   @map("app_version")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, deviceToken])
  @@index([platform])
  @@map("push_devices")
  @@schema("workspace_notifications")
}
