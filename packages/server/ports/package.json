{
  "name": "@workspace/ports",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "tsdown --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@workspace/types": "workspace:*",
    "@workspace/constants": "workspace:*"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./database": "./dist/database.mjs",
    "./database-client": "./dist/database-client.mjs",
    "./email": "./dist/email.mjs",
    "./events": "./dist/events.mjs",
    "./http": "./dist/http.mjs",
    "./payments": "./dist/payments.mjs",
    "./shared": "./dist/shared.mjs",
    "./storage": "./dist/storage.mjs",
    "./whatsapp": "./dist/whatsapp.mjs",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "@workspace/eslint": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "@types/node": "^24.10.0",
    "tsdown": "^0.20.3"
  }
}
