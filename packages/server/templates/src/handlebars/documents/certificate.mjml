<mjml>
  <mj-head>
    <mj-title>Certificate of Completion — {{certificateNumber}}</mj-title>
    <mj-attributes>
      <mj-all font-family="'Georgia', 'Times New Roman', serif" />
      <mj-text color="#111827" />
      <mj-section background-color="#ffffff" padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff" width="900px">
    <mj-section border="10px solid #1e3a8a" padding="48px 64px">
      <mj-column>
        <mj-text align="center">
          <span style="font-size: 16px; letter-spacing: 4px; text-transform: uppercase; font-weight: 700; color: #1e3a8a">Workspace</span>
        </mj-text>

        <mj-text font-size="40px" font-weight="700" align="center" color="#111827" padding-top="24px">
          Certificate of Completion
        </mj-text>

        <mj-text font-size="16px" color="#6b7280" align="center" padding-top="24px">
          This certifies that
        </mj-text>

        <mj-text align="center" padding-top="12px" padding-bottom="12px">
          <span style="font-size: 36px; font-weight: 700; color: #1e3a8a">{{memberName}}</span>
        </mj-text>

        <mj-text font-size="16px" color="#374151" align="center" padding-top="12px" line-height="1.7">
          has successfully completed the course
        </mj-text>

        <mj-text font-size="24px" font-weight="700" align="center" color="#111827" padding-top="12px">
          {{courseName}}
        </mj-text>

        {{#if programmeName}}
        <mj-text font-size="16px" color="#6b7280" align="center" padding-top="8px">
          as part of the {{programmeName}} programme
        </mj-text>
        {{/if}}

        <mj-text font-size="14px" color="#6b7280" align="center" padding-top="32px">
          Completed on {{completionDate}}
        </mj-text>

        <mj-table font-size="12px" padding-top="48px">
          <tr>
            <td style="width: 33%; text-align: center; vertical-align: bottom">
              <div style="color: #9ca3af; font-size: 11px">Certificate No.</div>
              <div style="color: #111827; font-weight: 700; margin-top: 2px">{{certificateNumber}}</div>
            </td>
            <td style="width: 34%; text-align: center; vertical-align: bottom">
              <div style="border-top: 1px solid #9ca3af; padding-top: 8px; margin: 0 24px">
                <div style="font-weight: 700; color: #111827; font-size: 14px">Workspace Academy</div>
              </div>
            </td>
            <td style="width: 33%; text-align: center; vertical-align: bottom">
              {{#if verificationUrl}}
              <div style="color: #9ca3af; font-size: 11px">Verify at</div>
              <div style="color: #1e3a8a; font-weight: 600; margin-top: 2px">{{verificationUrl}}</div>
              {{/if}}
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
