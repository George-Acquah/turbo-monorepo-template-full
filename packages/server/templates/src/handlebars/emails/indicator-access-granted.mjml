<mjml>
  <mj-head>
    <mj-title>Indicator access granted — Workspace</mj-title>
    <mj-preview>Your Workspace indicator is ready to add to your TradingView charts</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a { color: #2563eb; }
      .brand-tag { letter-spacing: 0.12em; text-transform: uppercase; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text align="right" color="#c7d2fe" font-size="11px" font-weight="700" css-class="brand-tag" padding="10px 0 0">
            Indicators
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="24px 24px 8px">
        <mj-column>
          <mj-text>Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},</mj-text>
          <mj-text>
            You now have access to <strong>{{#if productName}}{{productName}}{{else}}your Workspace indicator{{/if}}</strong>
            on TradingView. It should appear under Indicators &rarr; Invite-Only Scripts on your
            account within a few minutes.
          </mj-text>
          <mj-text>
            To add it: open a chart, click <em>Indicators</em>, choose <em>Invite-Only Scripts</em>,
            and select {{#if productName}}{{productName}}{{else}}the indicator{{/if}}.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="8px 24px 24px">
        <mj-column>
          <mj-button background-color="#2563eb" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{portalUrl}}/indicators" inner-padding="0">
            {{#if guideSlug}}Open the setup guide{{else}}Go to dashboard{{/if}}
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            This is an educational tool. It visualises a methodology; it is not a signal service or
            financial advice. Trading carries risk of loss.<br />
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
