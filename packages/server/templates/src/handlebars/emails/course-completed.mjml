<mjml>
  <mj-head>
    <mj-title>Course Completed — Workspace</mj-title>
    <mj-preview>Congratulations! You've completed the course</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a { color: #2563eb; }
      .brand-tag { letter-spacing: 0.12em; text-transform: uppercase; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" overflow="hidden" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text align="right" color="#c7d2fe" font-size="11px" font-weight="700" class="brand-tag" padding="10px 0 0">
            Learning & Mentorship
          </mj-text>
        </mj-column>
      </mj-section>

            <!-- Body -->
    <mj-section padding="24px 24px 8px">
      <mj-column>
        <mj-text>Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},</mj-text>
        <mj-text>
          Congratulations! You've successfully completed <strong>{{ courseName }}</strong>{{#if programmeName}} as part of <strong>{{ programmeName }}</strong>{{/if}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Completion details -->
    <mj-section background-color="#f9fafb" border-radius="8px" padding="20px 24px">
      <mj-column>
        <mj-table font-size="14px" color="#111827" cellpadding="9">
          <tr style="border-bottom: 1px solid #e5e7eb">
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Course</td>
            <td style="text-align: right; font-weight: 500">{{ courseName }}</td>
          </tr>
          {{#if programmeName}}
          <tr style="border-bottom: 1px solid #e5e7eb">
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Programme</td>
            <td style="text-align: right">{{ programmeName }}</td>
          </tr>
          {{/if}}
          <tr>
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Completed</td>
            <td style="text-align: right; font-weight: 600; color: #166534">{{formatDate completedAt}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    {{#if certificateUrl}}
    <mj-section padding="24px 24px 8px">
      <mj-column>
        <mj-text>Your certificate of completion is ready to download!</mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section padding="8px 24px 32px">
      <mj-column>
        <mj-button background-color="#2563eb" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{certificateUrl}}" inner-padding="0">
          Download certificate
        </mj-button>
      </mj-column>
    </mj-section>
    {{else}}
    <!-- CTA -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-button background-color="#2563eb" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{portalUrl}}" inner-padding="0">
          Continue learning
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}
      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
