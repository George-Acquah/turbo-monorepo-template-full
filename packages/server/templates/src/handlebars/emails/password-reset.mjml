<mjml>
  <mj-head>
    <mj-title>Reset Your Password — Workspace</mj-title>
    <mj-preview>A password reset was requested for your Workspace account</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a { color: #2563eb; }
      .brand-tag { letter-spacing: 0.12em; text-transform: uppercase; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" overflow="hidden" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text align="right" color="#c7d2fe" font-size="11px" font-weight="700" class="brand-tag" padding="10px 0 0">
            Learning & Mentorship
          </mj-text>
        </mj-column>
      </mj-section>

            <!-- Body -->
    <mj-section padding="32px 24px 8px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#111827" line-height="1.3" padding-bottom="16px">
          Reset your password
        </mj-text>
        <mj-text>Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},</mj-text>
        <mj-text>
          We received a request to reset the password for your Workspace account associated with <strong>{{ email }}</strong>. Click the button below to choose a new password.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section padding="8px 24px 24px">
      <mj-column>
        <mj-button background-color="#2563eb" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{resetUrl}}" inner-padding="0">
          Reset password
        </mj-button>
      </mj-column>
    </mj-section>

    {{#if expiryHours}}
    <mj-section padding="0 24px 16px">
      <mj-column>
        <mj-text font-size="13px" color="#6b7280">
          This link expires in {{ expiryHours }} hour(s).
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Security note -->
    <mj-section background-color="#fefce8" border-radius="8px" padding="16px 24px" border-left="4px solid #ca8a04">
      <mj-column>
        <mj-text font-size="13px" color="#713f12">
          ⚠️ If you didn't request a password reset, please ignore this email. Your password will not change. If you're concerned about your account security, contact us immediately.
        </mj-text>
      </mj-column>
    </mj-section>
      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
