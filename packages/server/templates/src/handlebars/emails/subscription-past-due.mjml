<mjml>
  <mj-head>
    <mj-title>Payment Overdue — Workspace</mj-title>
    <mj-preview>Your subscription payment is overdue — please update your payment details</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a { color: #2563eb; }
      .brand-tag { letter-spacing: 0.12em; text-transform: uppercase; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" overflow="hidden" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text align="right" color="#c7d2fe" font-size="11px" font-weight="700" class="brand-tag" padding="10px 0 0">
            Learning & Mentorship
          </mj-text>
        </mj-column>
      </mj-section>

            <!-- Body -->
    <mj-section padding="24px 24px 8px">
      <mj-column>
        <mj-text>Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},</mj-text>
        <mj-text>
          Your subscription for <strong>{{ programmeName }}</strong> is past due. We were unable to process your renewal payment.
          {{#if graceUntil}}
          Your access will remain active until <strong>{{formatDate graceUntil}}</strong> — please update your payment details before then to avoid losing access.
          {{else}}
          Please update your payment details as soon as possible to avoid losing access.
          {{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Details -->
    <mj-section background-color="#f9fafb" border-radius="8px" padding="20px 24px">
      <mj-column>
        <mj-table font-size="14px" color="#111827" cellpadding="9">
          <tr style="border-bottom: 1px solid #e5e7eb">
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Programme</td>
            <td style="text-align: right; font-weight: 500">{{ programmeName }}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb">
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Period Ended</td>
            <td style="text-align: right; color: #d97706; font-weight: 600">{{formatDate currentPeriodEnd}}</td>
          </tr>
          {{#if graceUntil}}
          <tr>
            <td style="color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase">Grace Period Ends</td>
            <td style="text-align: right; color: #dc2626; font-weight: 600">{{formatDate graceUntil}}</td>
          </tr>
          {{/if}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-button background-color="#d97706" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{portalUrl}}/billing" inner-padding="0">
          Update payment details
        </mj-button>
      </mj-column>
    </mj-section>
      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
