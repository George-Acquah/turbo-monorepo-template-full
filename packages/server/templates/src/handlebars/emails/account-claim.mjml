<mjml>
  <mj-head>
    <mj-title>Set up your Workspace account</mj-title>
    <mj-preview>Your payment is confirmed — choose a password to get in</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a {
        color: #2563eb;
      }
      .brand-tag {
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text
            align="right"
            color="#c7d2fe"
            font-size="11px"
            font-weight="700"
            css-class="brand-tag"
            padding="10px 0 0"
          >
            Learning & Mentorship
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="30px 28px 10px">
        <mj-column>
          <mj-text
            font-size="28px"
            font-weight="800"
            line-height="1.2"
            color="#0f172a"
            padding-bottom="12px"
          >
            You're paid up — let's get you in
          </mj-text>
          <mj-text color="#374151">
            Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},
          </mj-text>
          <mj-text color="#374151">
            Your payment{{#if programmeName}} for
            <strong>{{ programmeName }}</strong>{{/if}} is confirmed. You checked out as a guest, so
            there's one last step: choose a password so you can sign in to your members area.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="10px 28px 26px">
        <mj-column>
          <mj-button
            background-color="#2563eb"
            color="#ffffff"
            font-size="15px"
            font-weight="700"
            border-radius="10px"
            inner-padding="16px 26px"
            href="{{claimUrl}}"
          >
            Set your password
          </mj-button>
          <mj-text align="center" color="#64748b" font-size="13px" padding-top="12px">
            This link is for you only and expires in {{#if expiryDays}}{{ expiryDays }}{{else}}7{{/if}}
            days.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 28px 30px">
        <mj-column>
          <mj-text font-size="13px" color="#64748b" line-height="1.6">
            If the button doesn't work, copy and paste this link into your browser:<br />
            <a href="{{claimUrl}}">{{ claimUrl }}</a>
          </mj-text>
          <mj-text font-size="13px" color="#64748b" line-height="1.6" padding-top="10px">
            Didn't make this purchase? Let us know at
            <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a> and we'll sort it out.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a
            ><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
