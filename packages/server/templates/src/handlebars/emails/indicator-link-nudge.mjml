<mjml>
  <mj-head>
    <mj-title>Link your TradingView username — Workspace</mj-title>
    <mj-preview>One step to get your Workspace indicators onto your charts</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a { color: #2563eb; }
      .brand-tag { letter-spacing: 0.12em; text-transform: uppercase; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text align="right" color="#c7d2fe" font-size="11px" font-weight="700" css-class="brand-tag" padding="10px 0 0">
            Indicators
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="24px 24px 8px">
        <mj-column>
          <mj-text>Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},</mj-text>
          <mj-text>
            Your membership includes
            <strong>{{#if productName}}{{productName}}{{else}}Workspace indicators{{/if}}</strong> on
            TradingView. To receive access, link your TradingView username on your dashboard — it takes
            about a minute, then our team adds you to the invite-only script.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="8px 24px 24px">
        <mj-column>
          <mj-button background-color="#2563eb" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="14px 28px" href="{{portalUrl}}" inner-padding="0">
            Link my TradingView username
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
