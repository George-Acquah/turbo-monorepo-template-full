<mjml>
  <mj-head>
    <mj-title>Verify Your Email — Workspace</mj-title>
    <mj-preview>Confirm your email address to activate your Workspace account</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="15px" line-height="1.7" color="#111827" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      a {
        color: #2563eb;
      }
      .brand-tag {
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef2ff" width="640px">
    <mj-wrapper border="1px solid #e5e7eb" border-radius="18px" padding="0">
      <mj-section background-color="#0b1020" padding="22px 28px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="Workspace logo" align="left" width="120px" padding="0" />
        </mj-column>
        <mj-column>
          <mj-text
            align="right"
            color="#c7d2fe"
            font-size="11px"
            font-weight="700"
            css-class="brand-tag"
            padding="10px 0 0"
          >
            Learning & Mentorship
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="30px 28px 10px">
        <mj-column>
          <mj-text
            font-size="28px"
            font-weight="800"
            line-height="1.2"
            color="#0f172a"
            padding-bottom="12px"
          >
            Confirm your email address
          </mj-text>
          <mj-text color="#374151">
            Hi {{#if name}}{{cleanGreeting name}}{{else}}there{{/if}},
          </mj-text>
          <mj-text color="#374151">
            Welcome to Workspace. Please verify your email address to activate your account and
            continue your learning journey.
          </mj-text>
        </mj-column>
      </mj-section>

      {{#if verificationCode}}
      <mj-section padding="8px 28px 18px">
        <mj-column>
          <mj-table
            cellpadding="0"
            cellspacing="0"
            width="100%"
            container-background-color="#eff6ff"
          >
            <tr>
              <td
                style="
                  padding: 18px 20px 10px;
                  font-size: 12px;
                  text-transform: uppercase;
                  letter-spacing: 0.08em;
                  color: #1d4ed8;
                  font-weight: 700;
                  text-align: center;
                "
              >
                Verification code
              </td>
            </tr>
            <tr>
              <td
                style="
                  padding: 0 20px 18px;
                  font-size: 34px;
                  font-weight: 800;
                  letter-spacing: 12px;
                  color: #1e3a8a;
                  text-align: center;
                  font-family: monospace;
                "
              >
                {{ verificationCode }}
              </td>
            </tr>
          </mj-table>
          {{#if expiryMinutes}}
          <mj-text align="center" color="#64748b" font-size="13px" padding-top="10px">
            Expires in {{ expiryMinutes }} minutes
          </mj-text>
          {{/if}}
        </mj-column>
      </mj-section>
      {{/if}}

      {{#if verificationUrl}}
      <mj-section padding="10px 28px 26px">
        <mj-column>
          <mj-button
            background-color="#2563eb"
            color="#ffffff"
            font-size="15px"
            font-weight="700"
            border-radius="10px"
            inner-padding="16px 26px"
            href="{{verificationUrl}}"
          >
            Verify email address
          </mj-button>
        </mj-column>
      </mj-section>
      {{/if}}

      <mj-section padding="0 28px 30px">
        <mj-column>
          <mj-text font-size="13px" color="#64748b" line-height="1.6">
            If you didn’t create a Workspace account, no action is needed — this email will expire
            automatically.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="20px 28px 24px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#64748b" line-height="1.6">
            Need help? <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a
            ><br />
            © {{ year }} Workspace. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
