# Network resilience tuning. Added after two consecutive `pnpm install`
# failures inside Docker builds (docker/Dockerfile.API's installer stage) —
# both died mid-install with pnpm's own `TimeoutError: The operation was
# aborted due to timeout`. Root-caused directly: this connection tops out
# around ~1.2MB/s of *total* throughput regardless of how many requests share
# it (confirmed: 16 parallel fetches of the same 4.2MB package each took
# 30-51s instead of ~3.5s). pnpm's default network-concurrency (16) divides
# that same ~1.2MB/s across every in-flight package download, so on a fresh
# install (~1,150 packages here, including large native binaries — Prisma
# engines, Puppeteer's Chromium, sharp) some downloads don't finish before
# pnpm's default 60s fetch-timeout gives up.
#
# Lowering concurrency gives each in-flight download a bigger share of the
# same pipe; raising the timeout/retries tolerates the rest. Applies to every
# pnpm install on this machine (local dev, CI, both Docker builds) — not a
# Docker-only or ZAP-only fix.
network-concurrency=4
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
